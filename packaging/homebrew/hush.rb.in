# Homebrew formula for Hush. Generated by scripts/release.sh into ainurfqq/homebrew-tap; do not edit there.
class Hush < Formula
  desc "Local-first meeting notes for macOS: no bot, on-device transcript, any AI"
  homepage "https://github.com/ainurfqq/hush-meetings"
  url "https://github.com/ainurfqq/hush-meetings/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"

  depends_on arch: :arm64
  depends_on macos: :sonoma
  depends_on "whisper.cpp"

  def install
    system "bash", "scripts/build.sh"
    prefix.install "build/Hush.app"
    bin.install_symlink prefix/"Hush.app/Contents/MacOS/hush-cli" => "hush"
  end

  def caveats
    <<~EOS
      Start Hush:   hush open
        The first `hush` command links Hush.app into ~/Applications.
      The welcome guide downloads the speech models (about 800 MB, SHA-256 checked),
        or run: hush setup
      Claude Code MCP:
        claude mcp add --transport stdio --scope user hush -- #{HOMEBREW_PREFIX}/bin/hush mcp
      Hush is built on your Mac and is not notarized. macOS asks for Microphone and
      System Audio Recording the first time you record. Tell people when you record them.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/hush version")
  end
end
